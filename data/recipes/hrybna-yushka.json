  "steps": [
    {
      "stage": "Етап 1. Гриби",
      "text": "Гриби помити й нарізати, цибулю дрібно нарізати."
    },
    {
      "stage": "Етап 1. Гриби",
      "text": "Гриби з цибулею добре протушкувати на сковорідці."
    },
    {
      "stage": "Етап 2. Бульйон",
      "text": "У каструлю налити 2,5 л води й довести до кипіння."
    },
    {
      "stage": "Етап 2. Бульйон",
      "text": "Вкинути в окріп грибну приправу та добре протушковані гриби. Залишити варитися."
    },
    {
      "stage": "Етап 3. Сирна та сметанна заправки",
      "text": "Плавлені сирки порізати на сковорідку й влити трохи гарячої води."
    },
    {
      "stage": "Етап 3. Сирна та сметанна заправки",
      "text": "Розтерти сирки виделкою, щоб не було грудочок, і влити в бульйон."
    },
    {
      "stage": "Етап 3. Сирна та сметанна заправки",
      "text": "В окремій тарілці розтерти сметану з борошном і додати трішки холодної води."
    },
    {
      "stage": "Етап 3. Сирна та сметанна заправки",
      "text": "Влити сметанну заправку в бульйон і прокип’ятити.",
      "minutes": 5,
      "note": "Час: 5 хв (орієнтовно, залежить від плити й посуду)."
    },
    {
      "stage": "Етап 4. Часник і приправи",
      "text": "Вичавити часник у чашку, залити бульйоном або окропом і дати постояти.",
      "minutes": 5,
      "note": "Час: 5 хв (очікування, не активна робота)."
    },
    {
      "stage": "Етап 4. Часник і приправи",
      "text": "Влити часниковий настій у юшку, але без самого часнику."
    },
    {
      "stage": "Етап 4. Часник і приправи",
      "text": "Посолити й поперчити до смаку, додати лавровий лист, зелень петрушки, сушений майоран і базилік."
    }
  ],
